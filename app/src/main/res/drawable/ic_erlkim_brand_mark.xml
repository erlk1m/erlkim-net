            <gradient
                android:startX="3"
                android:startY="3"
                android:endX="37"
                android:endY="37"
                android:type="linear">
                <item android:color="#FF2B2129" android:offset="0.0" />
                <item android:color="#FF1B1622" android:offset="0.55" />
                <item android:color="#FF16202C" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Luminous Coral -> Lavender -> Sky gradient rim -->
    <path
        android:pathData="M11,2.5 L29,2.5 C33.69,2.5 37.5,6.31 37.5,11 L37.5,29 C37.5,33.69 33.69,37.5 29,37.5 L11,37.5 C6.31,37.5 2.5,33.69 2.5,29 L2.5,11 C2.5,6.31 6.31,2.5 11,2.5 Z"
