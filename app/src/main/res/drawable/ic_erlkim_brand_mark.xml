            <gradient
                android:startX="2"
                android:startY="2"
                android:endX="38"
                android:endY="38"
                android:type="linear">
                <item android:color="#FFF48C68" android:offset="0.0" />
                <item android:color="#FFBBA8FA" android:offset="0.5" />
                <item android:color="#FF64B5F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer wireless signal arc (top-right) -->
    <path
        android:pathData="M21.5,9.5 C26.6,9.5 30.5,13.4 30.5,18.5"
        android:fillColor="#00000000"
        android:strokeColor="#FF64B5F6"
